{
    "services": {
        "CoAuthoring": {
            "token": {
                "enable": {
                    "request": {
                        "inbox": false,
                        "outbox": false
                    },
                    "browser": false
                }
            },
            "ipfilter": {
                "rules": [{"address": "*", "allowed": true}],
                "defaultAllow": "true"
            }
        }
    }
}
